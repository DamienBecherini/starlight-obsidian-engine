# --- Multi-vault registry ---
# Register each vault with VAULT_<name>=<path> (absolute or relative to engine).
# Used by: --vault=<name> flag, npm run dev:<name>, npm run publish:<name>
# No file is mutated at runtime; the name is resolved to VAULT_PATH in memory only.
#
# Examples:
# VAULT_ia-on-prem=../ia-on-prem-vault
# VAULT_craft=../software-craft-vault

# Optional fallback: vault to use when no --vault flag is passed.
# If omitted, the engine falls back to src/content/docs (junction, if it exists).
VAULT_PATH=../ia-on-prem-vault

# To create an optional junction for IDE navigation (not required for build/dev):
#   npm run link:vault

# Deploy credentials live in the vault .env (one deploy target per vault).
# See your vault's .env.example for DEPLOY_HOST, DEPLOY_USER, DEPLOY_REMOTE_PATH, etc.

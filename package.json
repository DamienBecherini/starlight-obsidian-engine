{
  "name": "starlight-obsidian-engine",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lexicon:index": "node scripts/generate-lexicon-index.mjs",
    "lexicon:voir-aussi": "node scripts/format-lexicon-voir-aussi.mjs",
    "link-graph:build": "node scripts/build-link-graph.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "predev": "node scripts/ensure-vault.mjs && node scripts/run-lexicon-if-enabled.mjs && node scripts/build-link-graph.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/ensure-vault.mjs && node scripts/run-lexicon-if-enabled.mjs && node scripts/build-link-graph.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "link:vault": "node scripts/link-vault.mjs",
    "publish": "node scripts/publish.mjs",
    "deploy": "node scripts/deploy.mjs",
    "upload": "node scripts/upload.mjs",
    "auth:install": "node scripts/auth-install.mjs",
    "auth:remove": "node scripts/auth-remove.mjs",
    "run-with-vault": "node scripts/run-with-vault.mjs",
    "dev:ia-on-prem": "node scripts/run-with-vault.mjs ia-on-prem dev",
    "dev:craft": "node scripts/run-with-vault.mjs craft dev",
    "dev:knowledge": "node scripts/run-with-vault.mjs knowledge dev",
    "publish:ia-on-prem": "node scripts/publish.mjs --vault=ia-on-prem",
    "publish:craft": "node scripts/publish.mjs --vault=craft",
    "publish:knowledge": "node scripts/publish.mjs --vault=knowledge",
    "deploy:ia-on-prem": "node scripts/deploy.mjs --vault=ia-on-prem",
    "deploy:craft": "node scripts/deploy.mjs --vault=craft",
    "deploy:knowledge": "node scripts/deploy.mjs --vault=knowledge",
    "lint": "eslint .",
    "typecheck": "astro check",
    "duplication": "jscpd scripts config src --min-tokens 70 --threshold 5 --ignore \"**/*.test.mjs,tests/fixtures/**\" --reporters console",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=55 --test-concurrency=1 tests/**/*.test.mjs",
    "test:deploy": "npm test",
    "test:build": "node tests/smoke-build.mjs",
    "test:build:local": "node -e \"process.env.PAGEFIND='0'; import('./tests/smoke-build.mjs')\""
  },
  "dependencies": {
    "@astrojs/react": "^5.0.6",
    "@astrojs/starlight": "^0.39.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.3.6",
    "astro-mermaid": "^2.0.1",
    "basic-ftp": "^6.0.1",
    "ignore": "^7.0.5",
    "mermaid": "^11.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "remark-wiki-link": "^2.0.1",
    "sharp": "^0.34.5",
    "ssh2-sftp-client": "^12.0.1",
    "svg-pan-zoom": "^3.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "jscpd": "^5.4.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^6.0.3"
  }
}

---
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';
import TableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
import PageBacklinks from './PageBacklinks.astro';

const { toc } = Astro.locals.starlightRoute;
---

{
    toc ? (
        <>
            <div class="lg:sl-hidden">
                <MobileTableOfContents />
            </div>
            <div class="right-sidebar-panel sl-hidden lg:sl-block">
                <div class="right-sidebar-panel__inner">
                    <div class="sl-container page-sidebar-toc">
                        <TableOfContents />
                    </div>
                    <PageBacklinks mode="sidebar" />
                </div>
            </div>
        </>
    ) : (
        <div class="right-sidebar-panel sl-hidden lg:sl-block">
            <div class="right-sidebar-panel__inner">
                <PageBacklinks mode="sidebar" />
            </div>
        </div>
    )
}

<style>
    @layer starlight.core {
        .right-sidebar-panel {
            padding: 1rem var(--sl-sidebar-pad-x);
        }
        .right-sidebar-panel > .sl-container,
        .right-sidebar-panel__inner > .sl-container,
        .right-sidebar-panel :global(.page-backlinks) {
            width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
            min-width: 0;
            box-sizing: border-box;
        }
        .right-sidebar-panel :global(h2) {
            color: var(--sl-color-white);
            font-size: var(--sl-text-h5);
            font-weight: 600;
            line-height: var(--sl-line-height-headings);
            margin-bottom: 0.5rem;
        }
        .right-sidebar-panel :global(:where(a)) {
            display: block;
            font-size: var(--sl-text-xs);
            text-decoration: none;
            color: var(--sl-color-gray-3);
            overflow-wrap: anywhere;
        }
        .right-sidebar-panel :global(:where(a):hover) {
            color: var(--sl-color-white);
        }

        :global(:root[data-theme='dark'] #starlight__mobile-toc[open] .dropdown) {
            border-color: color-mix(in srgb, var(--sl-color-gray-4) 62%, transparent);
            border-top-color: color-mix(in srgb, var(--sl-color-gray-3) 52%, transparent);
            background-color: rgba(8, 13, 24, 0.88);
            background-color: color-mix(in srgb, var(--sl-color-black) 86%, transparent);
            box-shadow:
                0 1rem 2.75rem rgba(0, 0, 0, 0.72),
                0 0 0 1px rgba(255, 255, 255, 0.07),
                0 0 2rem rgba(80, 110, 170, 0.18);
            backdrop-filter: blur(12px) saturate(125%);
            -webkit-backdrop-filter: blur(12px) saturate(125%);
        }

        @supports not (backdrop-filter: blur(1px)) {
            :global(:root[data-theme='dark'] #starlight__mobile-toc[open] .dropdown) {
                background-color: var(--sl-color-black);
            }
        }

        @media (min-width: 72rem) {
            .right-sidebar-panel > .sl-container,
            .right-sidebar-panel__inner > .sl-container,
            .right-sidebar-panel :global(.page-backlinks) {
                max-width: calc(
                    (
                        (
                                100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 *
                                    var(--sl-sidebar-pad-x)
                            ) * 0.25
                    )
                );
            }

            :global([data-has-sidebar][data-has-toc] .right-sidebar) {
                overflow-y: hidden;
            }

            .right-sidebar-panel {
                height: calc(100vh - var(--sl-nav-height) - 2rem);
                max-height: calc(100vh - var(--sl-nav-height) - 2rem);
                overflow: hidden;
            }

            .right-sidebar-panel__inner {
                display: flex;
                flex-direction: column;
                height: 100%;
                min-height: 0;
                overflow: hidden;
            }

            .page-sidebar-toc {
                flex: 0 1 auto;
                max-height: 50vh;
                min-height: 0;
                overflow-y: auto;
                scrollbar-width: thin;
            }

            .right-sidebar-panel__inner :global(.page-backlinks) {
                flex: 1 1 0%;
                min-height: 0;
                overflow: hidden;
            }

            .right-sidebar-panel__inner:not(:has(.page-sidebar-toc)) :global(.page-backlinks) {
                max-height: 100%;
            }
        }
    }
</style>

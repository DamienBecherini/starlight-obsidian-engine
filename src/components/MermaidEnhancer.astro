---
// Progressive enhancement for Mermaid diagrams (pan/zoom, controls, fullscreen).
// The SVG is generated at build time by astro-mermaid; this script decorates it client-side.
---

<script>
    import svgPanZoom from 'svg-pan-zoom';

    // ───────────────────────────────────────────────────────────────────────────
    // SETTINGS — a diagram switches to zoomable mode (overlay) if AT LEAST one of
    // these three thresholds is exceeded. Otherwise it stays inline, crisp and static.
    // ───────────────────────────────────────────────────────────────────────────

    // Native width (viewBox units) above which the diagram is considered "wide".
    // Stable knob, independent of screen size: it is the intrinsic width of the drawing.
    const MAX_INLINE_WIDTH = 1500;
    // Native height (viewBox units) above which the diagram is considered "tall".
    const MAX_INLINE_HEIGHT = 480;
    // Minimum tolerated display scale (rendered width ÷ native width).
    // < 1 means Mermaid shrank the diagram to fit the column (so smaller text).
    // Safety net for narrow screens. 1 = no tolerance.
    const MIN_LEGIBLE_SCALE = 0.5;

    // Debug mode: shows a panel (under each diagram) with dimensions, scale, live zoom and verdict.
    // Set back to true to re-enable it; false = no panel injected.
    const DEBUG_MERMAID = false;

    type PanZoom = ReturnType<typeof svgPanZoom>;

    // Marker placed on the <svg> element (not the container): astro-mermaid recreates the SVG
    // on its re-renders (theme change), which wipes our controls. By keying on the SVG, a new
    // SVG triggers a clean re-injection of the controls.
    type EnhancedSvg = SVGSVGElement & { __mermaidEnhanced?: boolean };

    interface MermaidState {
        svg: SVGSVGElement;
        isSmall: boolean;
        panZoom: PanZoom | null;
        refreshDebug?: () => void;
        // svg-pan-zoom removes the viewBox attribute on init and does not restore it on destroy().
        // We remember the original to reapply it after fullscreen (small diagrams).
        originalViewBox?: string | null;
    }

    const el = <T extends Element>(parent: ParentNode, selector: string): T | null =>
        parent.querySelector<T>(selector);

    // Per-container state (avoids any leak: no data is attached to the document).
    const states = new WeakMap<HTMLElement, MermaidState>();

    // Container currently in fullscreen (tracked for the single global listeners).
    let currentFsContainer: HTMLElement | null = null;

    const makePanZoom = (svg: SVGSVGElement, onZoom?: (z: number) => void): PanZoom =>
        svgPanZoom(svg, {
            zoomEnabled: true,
            controlIconsEnabled: false,
            fit: true,
            center: true,
            // Wheel zoom is handled manually (Ctrl+wheel on the article, free wheel in fullscreen)
            // to avoid double-zoom and preserve page scrolling.
            mouseWheelZoomEnabled: false,
            preventMouseEventsDefault: false,
            // IMPORTANT: a DEFINED onZoom callback is required. Without it, svg-pan-zoom does not
            // visually apply the zoom in fullscreen (zoomIn/zoomOut/zoomAtPoint stay ineffective
            // until a pan occurs). So we always guarantee a function (default: no-op).
            onZoom: onZoom ?? (() => {}),
        });

    const refresh = (instance: PanZoom): void => {
        instance.resize();
        instance.fit();
        instance.center();
    };

    const enhanceContainer = (container: HTMLElement): void => {
        const svg = container.querySelector<EnhancedSvg>('svg');
        // The SVG may not be rendered yet by astro-mermaid: we let the observer call back later.
        if (!svg) return;

        // Already enhanced (this exact SVG)? Bail out. An astro-mermaid re-render creates a new SVG
        // without this marker, which will restart enhancement and re-inject the controls.
        if (svg.__mermaidEnhanced) return;
        svg.__mermaidEnhanced = true;

        // Cleanup of a previous render: destroy the old instance and remove the leftover debug panel
        // (as a sibling, it survives the innerHTML that wipes the internal controls).
        const previous = states.get(container);
        if (previous?.panZoom) {
            try {
                previous.panZoom.destroy();
            } catch {
                /* instance already detached */
            }
        }
        const staleDebug = container.nextElementSibling;
        if (staleDebug?.classList.contains('mermaid-debug')) staleDebug.remove();

        // 1. Inline vs zoomable decision, based on three independent thresholds:
        //    - native width too large (MAX_INLINE_WIDTH)
        //    - native height too large (MAX_INLINE_HEIGHT)
        //    - display scale too low = shrunk/illegible text (MIN_LEGIBLE_SCALE)
        const viewBox = svg.getAttribute('viewBox');
        let naturalW = 0;
        let naturalH = 0;
        if (viewBox) {
            const parts = viewBox.split(/[\s,]+/).map(Number).filter((n) => !Number.isNaN(n));
            if (parts.length === 4) {
                naturalW = parts[2];
                naturalH = parts[3];
            }
        }

        const rect = svg.getBoundingClientRect();
        const displayedW = rect.width || naturalW;
        const displayedH = rect.height || naturalH;
        // Display scale = rendered width / native width (≤ 1: Mermaid never exceeds 100%).
        const displayScale = naturalW > 0 ? displayedW / naturalW : 1;

        // Each exceeded threshold is recorded for the debug overlay (we see which one triggered).
        const triggers: string[] = [];
        if (naturalW > MAX_INLINE_WIDTH) triggers.push(`width ${Math.round(naturalW)} > ${MAX_INLINE_WIDTH}`);
        if (naturalH > MAX_INLINE_HEIGHT) triggers.push(`height ${Math.round(naturalH)} > ${MAX_INLINE_HEIGHT}`);
        if (displayScale < MIN_LEGIBLE_SCALE) triggers.push(`scale ${displayScale.toFixed(2)} < ${MIN_LEGIBLE_SCALE}`);

        const needsZoom = triggers.length > 0;
        const isSmall = !needsZoom;

        const state: MermaidState = { svg, isSmall, panZoom: null, originalViewBox: viewBox };
        states.set(container, state);

        // Debug overlay (optional): dimensions, scale, verdict and live zoom.
        let debugEl: HTMLDivElement | null = null;
        if (DEBUG_MERMAID) {
            debugEl = document.createElement('div');
            debugEl.className = 'mermaid-debug';
            // Outside the diagram, right below it: visible whatever the verdict and never clipped by overflow.
            container.insertAdjacentElement('afterend', debugEl);
            const renderDebug = () => {
                if (!debugEl) return;
                const z = state.panZoom ? state.panZoom.getZoom() : null;
                debugEl.innerHTML = `
                    <div class="dbg-verdict ${isSmall ? 'is-inline' : 'is-zoom'}">${isSmall ? '● INLINE (crisp)' : '● ZOOM (overlay)'}</div>
                    <div>viewBox&nbsp;: <b>${Math.round(naturalW)}</b> × <b>${Math.round(naturalH)}</b></div>
                    <div>rendered&nbsp;: ${Math.round(displayedW)} × ${Math.round(displayedH)} px</div>
                    <div>init scale&nbsp;: <b>${displayScale.toFixed(2)}</b> (min ${MIN_LEGIBLE_SCALE})</div>
                    <div>thresholds W/H&nbsp;: ${MAX_INLINE_WIDTH} / ${MAX_INLINE_HEIGHT}</div>
                    <div>live zoom&nbsp;: <b>${z != null ? z.toFixed(2) + '×' : '—'}</b></div>
                    <div class="dbg-triggers">${triggers.length ? '⚠ ' + triggers.join(' · ') : 'no threshold crossed'}</div>
                `;
            };
            state.refreshDebug = renderDebug;
        }

        // 2. Conditional application of styles and zoom initialization.
        if (!isSmall) {
            svg.style.width = '100%';
            svg.style.height = '480px';
            svg.style.maxWidth = 'none';
            state.panZoom = makePanZoom(svg, state.refreshDebug);
        } else {
            container.classList.add('is-small');
        }
        state.refreshDebug?.();

        // Smart wheel zoom: Ctrl+wheel inside the article, free wheel in fullscreen.
        svg.addEventListener(
            'wheel',
            (e: WheelEvent) => {
                const instance = state.panZoom;
                if (!instance) return;
                const isFS = document.fullscreenElement === container;
                if (!isFS && !e.ctrlKey) return;
                e.preventDefault();
                const rect = svg.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const factor = e.deltaY < 0 ? 1.15 : 0.85;
                instance.zoomAtPoint(instance.getZoom() * factor, { x, y });
            },
            { passive: false },
        );

        // Geometric control pad (GitHub style).
        const controls = document.createElement('div');
        controls.className = 'mermaid-custom-controls';
        controls.innerHTML = `
            <div class="action-group">
                <button class="mermaid-ctrl-btn btn-copy" title="Copy Mermaid code">
                    <svg class="copy-icon-normal" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    <svg class="copy-icon-success" viewBox="0 0 24 24" width="14" height="14" stroke="#22c55e" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </button>
                <button class="mermaid-ctrl-btn btn-fs" title="Fullscreen">
                    <svg class="fs-icon-enter" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
                    <svg class="fs-icon-exit" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M10 14l-7 7"/></svg>
                </button>
            </div>
            <div class="pan-grid">
                <button class="mermaid-ctrl-btn btn-up" title="Pan up" style="grid-area: up;">
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
                </button>
                <button class="mermaid-ctrl-btn btn-left" title="Pan left" style="grid-area: left;">
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                <button class="mermaid-ctrl-btn btn-reset" title="Reset view" style="grid-area: reset;">
                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                </button>
                <button class="mermaid-ctrl-btn btn-right" title="Pan right" style="grid-area: right;">
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
                <button class="mermaid-ctrl-btn btn-zoom-in" title="Zoom in" style="grid-area: zoomin;">
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
                </button>
                <button class="mermaid-ctrl-btn btn-zoom-out" title="Zoom out" style="grid-area: zoomout;">
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
                </button>
                <button class="mermaid-ctrl-btn btn-down" title="Pan down" style="grid-area: down;">
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
            </div>
        `;
        container.appendChild(controls);

        // Top-right fullscreen close button (rectangular format like the others).
        const closeFsBtn = document.createElement('button');
        closeFsBtn.className = 'mermaid-close-fs-btn';
        closeFsBtn.title = 'Exit fullscreen';
        closeFsBtn.innerHTML = `
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        `;
        container.appendChild(closeFsBtn);

        closeFsBtn.addEventListener('click', () => {
            if (document.fullscreenElement) document.exitFullscreen();
        });

        // Animated tooltip (Ctrl + wheel).
        const hint = document.createElement('div');
        hint.className = 'mermaid-zoom-hint';
        hint.innerHTML = `
            <span class="ctrl-key">CTRL</span>
            <span class="plus-sign">＋</span>
            <div class="mouse-animation">
                <svg class="mouse-svg" viewBox="0 0 24 36" width="16" height="24">
                    <rect x="2" y="2" width="20" height="32" rx="10" fill="none" stroke="grey" stroke-width="2"/>
                    <line x1="12" y1="2" x2="12" y2="12" stroke="dark-grey" stroke-width="2"/>
                    <rect class="scroll-wheel" x="10" y="6" width="4" height="6" rx="2" fill="#ef4444"/>
                    <g class="arrow-up-wrapper">
                        <path class="scroll-arrow arrow-up" d="M12,4 L9,7 M12,4 L15,7" fill="none" stroke="#ef4444" stroke-width="1.5" stroke-linecap="round"/>
                    </g>
                    <path class="scroll-arrow arrow-down" d="M12,18 L9,15 M12,18 L15,15" fill="none" stroke="#ef4444" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </div>
            <span class="hint-text">to zoom</span>
        `;
        container.appendChild(hint);

        // Pan via directional buttons (safe: no effect until the instance is active).
        const panStep = 60;
        el(controls, '.btn-up')?.addEventListener('click', () => state.panZoom?.panBy({ x: 0, y: panStep }));
        el(controls, '.btn-down')?.addEventListener('click', () => state.panZoom?.panBy({ x: 0, y: -panStep }));
        el(controls, '.btn-left')?.addEventListener('click', () => state.panZoom?.panBy({ x: panStep, y: 0 }));
        el(controls, '.btn-right')?.addEventListener('click', () => state.panZoom?.panBy({ x: -panStep, y: 0 }));
        el(controls, '.btn-reset')?.addEventListener('click', () => {
            if (state.panZoom) refresh(state.panZoom);
        });
        el(controls, '.btn-zoom-in')?.addEventListener('click', () => {
            const instance = state.panZoom;
            if (instance) instance.zoomIn();
        });
        el(controls, '.btn-zoom-out')?.addEventListener('click', () => {
            const instance = state.panZoom;
            if (instance) instance.zoomOut();
        });

        // Fullscreen (Fullscreen API).
        el<HTMLElement>(controls, '.btn-fs')?.addEventListener('click', () => {
            if (!document.fullscreenElement) {
                container.requestFullscreen().catch((err) => console.log(err));
            } else {
                document.exitFullscreen();
            }
        });

        // Copy the raw Mermaid code (from the SVG's native <desc>).
        const btnCopy = el<HTMLElement>(controls, '.btn-copy');
        btnCopy?.addEventListener('click', () => {
            const rawCode = svg.querySelector('desc')?.textContent ?? '';
            navigator.clipboard.writeText(rawCode).then(() => {
                btnCopy.classList.add('copied');
                const copyTooltip = document.createElement('div');
                copyTooltip.className = 'mermaid-copy-tooltip';
                copyTooltip.innerText = 'Copied!';
                btnCopy.appendChild(copyTooltip);
                setTimeout(() => {
                    btnCopy.classList.remove('copied');
                    copyTooltip.remove();
                }, 2000);
            });
        });
    };

    // --- SINGLE global listeners (attached only once at module level) ---

    const enterFullscreen = (container: HTMLElement, state: MermaidState): void => {
        container.classList.add('is-fullscreen');
        if (state.isSmall) {
            // On-the-fly init for small diagrams: they become zoomable/pannable.
            state.svg.style.width = '100vw';
            state.svg.style.height = '100vh';
            state.panZoom = makePanZoom(state.svg, state.refreshDebug);
        } else if (state.panZoom) {
            requestAnimationFrame(() => state.panZoom && refresh(state.panZoom));
        }
        state.refreshDebug?.();
    };

    const exitFullscreen = (container: HTMLElement, state: MermaidState): void => {
        container.classList.remove('is-fullscreen');
        if (state.isSmall) {
            // Clean teardown: back to the original crisp static state.
            // svg-pan-zoom's destroy() may throw ("fn is undefined" while removing listeners);
            // we isolate it so we do NOT interrupt the visual cleanup below (otherwise empty diagram on exit).
            try {
                state.panZoom?.destroy();
            } catch {
                /* partial teardown: we continue the cleanup below */
            }
            state.panZoom = null;
            state.svg.style.width = '';
            state.svg.style.height = '';
            // svg-pan-zoom removes the viewBox on init without restoring it (→ default 300x150 SVG),
            // and writes its transform (fit/center) in a DEFERRED way via requestAnimationFrame.
            // On exit, a transform write may still be PENDING: a synchronous cleanup would be overwritten
            // by that deferred frame, which would reapply the fullscreen transform (translate ≈ height/2)
            // onto the now-inline SVG → content pushed off-frame (empty diagram).
            // So we defer the restore by one frame to run AFTER the lib's write (FIFO order of rAFs).
            const svg = state.svg;
            const originalViewBox = state.originalViewBox;
            requestAnimationFrame(() => {
                if (originalViewBox) svg.setAttribute('viewBox', originalViewBox);
                const viewport = svg.querySelector<SVGGElement>('.svg-pan-zoom_viewport');
                if (viewport) {
                    viewport.removeAttribute('transform');
                    viewport.style.transform = '';
                }
            });
        } else if (state.panZoom) {
            requestAnimationFrame(() => state.panZoom && refresh(state.panZoom));
        }
        state.refreshDebug?.();
    };

    document.addEventListener('fullscreenchange', () => {
        const fsEl = document.fullscreenElement as HTMLElement | null;

        // Exit of the container previously in fullscreen.
        if (currentFsContainer && currentFsContainer !== fsEl) {
            const prev = states.get(currentFsContainer);
            if (prev) exitFullscreen(currentFsContainer, prev);
            currentFsContainer = null;
        }

        // Entry of a known container.
        if (fsEl && states.has(fsEl)) {
            enterFullscreen(fsEl, states.get(fsEl)!);
            currentFsContainer = fsEl;
        }
    });

    document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (!currentFsContainer) return;
        const instance = states.get(currentFsContainer)?.panZoom;
        if (!instance) return;
        const panStep = 40;
        switch (e.key) {
            case 'ArrowUp':
                e.preventDefault();
                instance.panBy({ x: 0, y: panStep });
                break;
            case 'ArrowDown':
                e.preventDefault();
                instance.panBy({ x: 0, y: -panStep });
                break;
            case 'ArrowLeft':
                e.preventDefault();
                instance.panBy({ x: panStep, y: 0 });
                break;
            case 'ArrowRight':
                e.preventDefault();
                instance.panBy({ x: -panStep, y: 0 });
                break;
        }
    });

    // --- Deterministic detection of Mermaid render via MutationObserver ---

    let scanQueued = false;
    const scan = (): void => {
        scanQueued = false;
        document.querySelectorAll<HTMLElement>('.mermaid').forEach(enhanceContainer);
    };
    const queueScan = (): void => {
        if (scanQueued) return;
        scanQueued = true;
        requestAnimationFrame(scan);
    };

    const observer = new MutationObserver(queueScan);
    observer.observe(document.body, { childList: true, subtree: true });

    // Initial scan + safety net on Starlight navigation (idempotent thanks to the SVG marker).
    queueScan();
    document.addEventListener('astro:page-load', queueScan);
</script>

---
// Override Starlight: render the default <head>, add what Starlight does not emit (og:image,
// author, JSON-LD), then inject the Mermaid enhancer.
import Default from '@astrojs/starlight/components/Head.astro';
import MermaidEnhancer from './MermaidEnhancer.astro';
import FootnoteBackrefHighlight from './FootnoteBackrefHighlight.astro';
import { loadSiteConfig } from '../../config/site.mjs';
import {
    buildJsonLd,
    canonicalFromHead,
    hasHeadMeta,
    serializeJsonLd,
} from '../../config/seo.mjs';

const site = loadSiteConfig();
const route = Astro.locals.starlightRoute;
const head = route.head;
const ogImage = site.ogImage ?? '';
const articleAuthor = site.editorial?.hitl?.url ?? site.editorial?.hitl?.name ?? '';
// Use the build date as published_time so LinkedIn shows a date.
// Individual pages could override this in the future via frontmatter.
const publishedTime = new Date().toISOString();

// Starlight already emits twitter:card; only add the tags it does not.
const twitterCard = ogImage && !hasHeadMeta(head, 'twitter:card');
const twitterImage = ogImage && !hasHeadMeta(head, 'twitter:image');

const data = route.entry.data as typeof route.entry.data & { last_modified?: string };
const jsonLd = serializeJsonLd(
    buildJsonLd({
        kind: data.template === 'splash' ? 'website' : 'article',
        title: data.title,
        siteTitle: site.title,
        siteUrl: site.url,
        description: data.description,
        lang: route.lang,
        url: canonicalFromHead(head),
        dateModified: data.last_modified,
        author: site.editorial?.hitl,
    }),
);
---

<Default><slot /></Default>
{ogImage && <meta property="og:image" content={ogImage} />}
{twitterCard && <meta name="twitter:card" content="summary_large_image" />}
{twitterImage && <meta name="twitter:image" content={ogImage} />}
{articleAuthor && <meta property="article:author" content={articleAuthor} />}
{site.editorial?.hitl?.name && <meta name="author" content={site.editorial.hitl.name} />}
<meta property="article:published_time" content={publishedTime} />
<script is:inline type="application/ld+json" set:html={jsonLd} />
<MermaidEnhancer />
<FootnoteBackrefHighlight />
